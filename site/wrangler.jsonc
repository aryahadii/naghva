// Cloudflare serves the built site as static files. The only server code is
// the analytics relay, which runs for /relay/* and nothing else.
{
  "name": "naghva",
  "main": "./worker/relay.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "naghva.com", "custom_domain": true },
    { "pattern": "naqva.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/relay/*"]
  }
}
