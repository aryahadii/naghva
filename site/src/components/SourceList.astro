---
import { accessed, type CitedSource } from '../lib/citations';
import { dateHtml, esc, langAttrs } from '../lib/html';
import { fill, num, plural, strings } from '../lib/i18n';
import type { Lang } from '../lib/record';

/** Every source the page cites, numbered, each with the quotes the page rests on. */
interface Props { lang: Lang; sources: CitedSource[] }
const { lang, sources } = Astro.props;
const t = strings(lang).cite;
/** Sources shown before the reader asks for the rest. */
const SHOWN = 5;
const folds = sources.length > SHOWN + 1;
const title = (c: CitedSource) => {
  // Titles often mix scripts (“Golsa: سایه”), so their direction comes from their first letter.
  const language = c.source.language ?? lang;
  const attrs = (language.split('-')[0] === lang ? '' : ` lang="${esc(language)}"`) + ' dir="auto"';
  return c.source.url
    ? `<a class="source-title" href="${esc(c.source.url)}" target="_blank" rel="noopener noreferrer"${attrs}>${esc(c.source.title)}</a>`
    : `<span class="source-title"${attrs}>${esc(c.source.title)}</span>`;
};
const details = (c: CitedSource) => {
  const s = c.source;
  const out = [];
  if (s.publisher) out.push(`<span${langAttrs(s.language ?? lang, lang)}>${esc(s.publisher)}</span>`);
  if (s.issued && typeof s.issued === 'object') out.push(dateHtml(s.issued, lang));
  if (s.archive) out.push(`<a href="${esc(s.archive)}" target="_blank" rel="noopener noreferrer">${esc(t.archived)}</a>`);
  return out.length ? ' · ' + out.join(' · ') : '';
};
---

<ol class="source-list" id="source-list" data-folds={folds ? '' : undefined}>
  {sources.map((c, i) => (
    <li id={`source-${c.n}`} class={folds && i >= SHOWN ? 'source-extra' : undefined}>
      <span class="source-num">{num(lang, c.n)}</span>
      <div>
        <Fragment set:html={title(c) + details(c)} />
        <details class="source-quotes">
          <summary>{plural(lang, t.quotes, c.quotes.length)}</summary>
          {c.quotes.map((q) => (
            <blockquote id={q.id} set:html={`<span${langAttrs(c.source.language ?? lang, lang)}>${esc(q.quote)}</span><br><span class="quote-meta">${esc([q.locator ? fill(t.at, { locator: q.locator }) : '', accessed(q, lang)].filter(Boolean).join(' · '))}</span>`} />
          ))}
        </details>
      </div>
    </li>
  ))}
</ol>
{folds && (
  <button class="pill needs-js source-more" id="source-more" aria-expanded="false" aria-controls="source-list" data-more={fill(t.more, { count: num(lang, sources.length) })} data-less={t.less}>{fill(t.more, { count: num(lang, sources.length) })}</button>
)}

<div class="cite-pop" id="cite-pop" popover role="dialog" aria-label={fill(t.source, { n: '' }).trim()} data-open={t.open} data-in-sources={t.inSources}></div>

<script>
  import '../scripts/citations';
</script>
