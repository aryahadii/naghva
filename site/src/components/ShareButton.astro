---
import { getImage } from 'astro:assets';
import branch from '../assets/art/nightingale-branch.png';
import frieze from '../assets/art/garden-frieze.png';
import wordmark from '../../../assets/brand/logos/wordmark-with-rule/naghva-wordmark-with-rule-on-dark-transparent.svg?url';
import type { LinkedImage } from '../lib/images';
import { fill, strings } from '../lib/i18n';
import type { Lang, Text } from '../lib/record';
import { BRAND_ICONS } from '../lib/share-icons';

/**
 * Sharing an Artist page. Apps that read link previews (Telegram, WhatsApp, X,
 * Facebook) get plain links that work without JavaScript. With it, the menu
 * also copies the address, opens the device's share sheet, and makes a 9:16
 * story image of the artist in the page itself (scripts/share.ts), which
 * phones hand to Instagram Stories and computers download.
 */
interface Props {
  lang: Lang;
  /** The page's full address. */
  address: string;
  name: Text;
  other: Text | null;
  kicker: string;
  photo: LinkedImage | null;
}
const { lang, address, name, other, kicker, photo } = Astro.props;
const t = strings(lang).share;
const text = fill(t.text, { name: name.text });
const enc = encodeURIComponent;
const apps = [
  { id: 'telegram', name: t.telegram, href: `https://t.me/share/url?url=${enc(address)}&text=${enc(text)}` },
  { id: 'whatsapp', name: t.whatsapp, href: `https://wa.me/?text=${enc(`${text} ${address}`)}` },
  { id: 'x', name: t.x, href: `https://x.com/intent/post?url=${enc(address)}&text=${enc(text)}` },
  { id: 'facebook', name: t.facebook, href: `https://www.facebook.com/sharer/sharer.php?u=${enc(address)}` },
] as const;
const story = {
  lang,
  address,
  site: new URL(address).host,
  name: name.text,
  other: other?.text ?? null,
  kicker,
  photo: photo ? { src: photo.src, fallback: photo.fallback ?? null } : null,
  art: {
    branch: (await getImage({ src: branch, width: 720, format: 'webp' })).src,
    frieze: (await getImage({ src: frieze, width: 1080, format: 'webp' })).src,
    wordmark,
  },
  file: `${new URL(address).pathname.split('/').filter(Boolean).pop()}-story.png`,
};
const shown = address.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<div class="share">
  <button class="pill title-action share-open" type="button" popovertarget="share-menu" aria-haspopup="dialog" aria-label={t.share} title={t.share}>
    <svg class="title-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 15V3.5M7.5 8 12 3.5 16.5 8M8 11H6.5A2.5 2.5 0 0 0 4 13.5v5A2.5 2.5 0 0 0 6.5 21h11a2.5 2.5 0 0 0 2.5-2.5v-5a2.5 2.5 0 0 0-2.5-2.5H16" /></svg>
  </button>
  <div class="share-menu" id="share-menu" popover role="dialog" aria-labelledby="share-heading" data-story={JSON.stringify(story)}>
    <span class="share-grab" aria-hidden="true"></span>
    <header class="share-head">
      <h2 class="share-heading" id="share-heading">{t.share}</h2>
      <button class="share-close" type="button" popovertarget="share-menu" popovertargetaction="hide" aria-label={t.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </header>
    <ul class="share-apps">
      <li class="needs-js">
        <button class="share-app share-story" type="button" title={t.storyTitle}>
          <span class="share-icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="brand" d={BRAND_ICONS.instagram} /></svg></span>
          <span class="share-label">{t.story}</span>
        </button>
      </li>
      {apps.map((a) => (
        <li>
          <a class="share-app" href={a.href} target="_blank" rel="noopener noreferrer">
            <span class="share-icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="brand" d={BRAND_ICONS[a.id]} /></svg></span>
            <span class="share-label">{a.name}</span>
          </a>
        </li>
      ))}
      <li class="share-more-item" hidden>
        <button class="share-app share-more" type="button">
          <span class="share-icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="1.6" /><circle cx="12" cy="12" r="1.6" /><circle cx="19" cy="12" r="1.6" /></svg></span>
          <span class="share-label">{t.more}</span>
        </button>
      </li>
    </ul>
    <div class="share-link needs-js">
      <span class="share-address" dir="ltr" lang="en" translate="no">{shown}</span>
      <button class="share-copy" type="button" data-done={t.copied}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="8.5" y="8.5" width="11" height="11" rx="2.5" /><path d="M15.5 5.5v-.5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7.5a2 2 0 0 0 2 2h.5" /></svg>
        <span>{t.copy}</span>
      </button>
    </div>
    <p
      class="share-note"
      role="status"
      data-story-phone={t.storyPhone}
      data-story-phone-no-copy={t.storyPhoneNoCopy}
      data-story-desktop={t.storyDesktop}
      data-story-desktop-no-copy={t.storyDesktopNoCopy}
      data-preparing={t.preparing}
      data-ready={t.ready}
      data-copy-manual={t.copyManual}
      data-failed={t.failed}
    ></p>
  </div>
</div>

<script>
  import '../scripts/share';
</script>
