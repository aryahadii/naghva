---
/** Horizontal bars: one labelled row per value. */
export interface Bar { label: string; width: number; color: string; value: string }
interface Props {
  bars: Bar[];
  tight?: boolean;
}

const { bars, tight = false } = Astro.props;
---
<ul class={`hbars${tight ? ' hbars-tight' : ''}`}>{bars.map((b) => <li><span class="hb-label">{b.label}</span><span class="hb-bar" style={`--w:${b.width}%;--c:${b.color}`}></span><span class="hb-val">{b.value}</span></li>)}</ul>
