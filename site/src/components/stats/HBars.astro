---
/** Horizontal bars: one labelled row per value. */
export interface Bar { label: string; width: number; color: string; value: string }
interface Props {
  bars: Bar[];
  tight?: boolean;
  /** Set the labels' direction, for names in Latin script on a Persian page. */
  labelDir?: 'ltr' | 'rtl';
}

const { bars, tight = false, labelDir } = Astro.props;
---
<ul class={`hbars${tight ? ' hbars-tight' : ''}`}>{bars.map((b) => <li><span class="hb-label" dir={labelDir}>{b.label}</span><span class="hb-bar" style={`--w:${b.width}%;--c:${b.color}`}></span><span class="hb-val">{b.value}</span></li>)}</ul>
