---
import { createHash } from 'node:crypto';
import Page from '../../layouts/Page.astro';
import StarMap from '../../islands/StarMap';
import { strings } from '../../lib/i18n';
import { LANGS, loadRecord, url, type Lang } from '../../lib/record';
import { buildStarMap } from '../../lib/star-map';
import '../../styles/star-map.css';

export function getStaticPaths() { return LANGS.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = strings(lang);
const words = t.starMap;
const stars = buildStarMap(loadRecord(), lang);
const catalogue = JSON.stringify(stars).replace(/</g, '\\u003c');
const fingerprint = createHash('sha256').update(catalogue).digest('hex').slice(0, 16);
const artistCount = stars.filter(star => star.kind === 'artist').length;
---
<Page lang={lang} title={`${words.title} | ${t.siteName}`} description={words.description} section="star-map" path="star-map/">
  <main class="wrap star-map" id="content" data-catalogue={fingerprint}>
    <div class="atlas-intro">
      <h1>{words.title}</h1>
      <p>{words.description}</p>
    </div>
    <script is:inline type="application/json" id="sky-catalogue" set:html={catalogue} />
    {stars.length > 0 && <div class="needs-js"><StarMap artistCount={artistCount} recordingCount={stars.length - artistCount} lang={lang} words={words} client:load /></div>}
    <noscript><a href={url(lang, 'artists')}>{words.directory}</a></noscript>
  </main>
</Page>
