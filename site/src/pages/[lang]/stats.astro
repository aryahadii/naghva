---
import Page from '../../layouts/Page.astro';
import { partsOf } from '../../lib/dates';
import { num, strings } from '../../lib/i18n';
import type { PlatformKey } from '../../lib/platforms';
import { LANGS, loadRecord, nameOf, REPOSITORY, url, type Lang } from '../../lib/record';
import HBars from '../../components/stats/HBars.astro';
import YearColumns from '../../components/stats/YearColumns.astro';
import '../../styles/stats.css';

/** Statistics: what the record holds and how complete it is, counted at build time. */
export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const en = lang === 'en';
const record = loadRecord();
const d = record.stats;
const T = (e: string, f: string) => (en ? e : f);
const n = (x: number) => num(lang, x);
const pct = (a: number, b: number) => (b ? Math.round((a / b) * 100) : 0);
const p = (a: number, b: number) => (en ? `${pct(a, b)}%` : `٪${n(pct(a, b))}`);
/** A section shows once the field it counts covers this share of what it counts. */
const SHOW_AT = 0.3;

const title = T('Naghva statistics | What the archive holds', 'آمار نغوا | آنچه در آرشیو هست');
const description = T(
  'Naghva’s archive in numbers: releases by year, when artists started, where the music can be heard, who works with whom, and where the gaps are.',
  'آرشیو نغوا به روایت آمار: آثار منتشرشده در هر سال، زمان آغاز کار هنرمندان، جاهایی که می‌شود این موسیقی را شنید، شبکهٔ همکاری‌ها و جاهای خالی آرشیو.',
);
const fmt = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(en ? 'en-GB' : 'fa-IR-u-ca-persian', { ...o, timeZone: 'UTC' });
// The newest date anything in the record was read, so a rebuild alone does not move it.
const built = fmt({ day: 'numeric', month: 'long', year: 'numeric' }).format(d.updated ? new Date(d.updated) : new Date());

// Years in the page's calendar, one column per year for the last 26 years; anything older
// is one "earlier" column, so a few early releases don't stretch the axis across decades.
const nowYear = partsOf(new Date().toISOString().slice(0, 10), lang).y;
const FIRST = nowYear - 26;
const byYear = (days: string[]) => {
  const counts = new Map<number, number>();
  let earlier = 0;
  for (const day of days) {
    const y = partsOf(day, lang).y;
    if (y < FIRST) earlier++;
    else counts.set(y, (counts.get(y) ?? 0) + 1);
  }
  const years = Array.from({ length: nowYear - FIRST + 1 }, (_, i) => ({ y: FIRST + i, n: counts.get(FIRST + i) ?? 0, earlier: false }));
  return earlier ? [{ y: FIRST - 1, n: earlier, earlier: true }, ...years] : years;
};
const earlierLabel = T('Earlier', 'پیش‌تر');
const scale = (max: number) => {
  const step = max > 100 ? 50 : max > 40 ? 20 : max > 10 ? 5 : 2;
  return Math.ceil(max / step) * step;
};

// Releases per year. Releases before 1995 are few; they still count, and the axis starts at the first.
const rel = byYear(d.releases.days);
const relScale = scale(Math.max(1, ...rel.map((r) => r.n)));

// When artists started.
const starts = byYear(d.starts.days);
const startMax = scale(Math.max(1, ...starts.map((s) => s.n)));

// Listening.
const ls = d.listen;

// Network. The layout's unit is the picture's height.
const net = d.network;
const H = 625, W = Math.round(H * (net.box ?? 1.6));
const at = Object.fromEntries(net.nodes.map((x: any) => [x.id, { x: x.x * H, y: x.y * H }]));
const pos = (id: string) => at[id];
const label = (id: string) => nameOf(record.items[id], lang).text;
const other = (id: string) => nameOf(record.items[id], en ? 'fa' : 'en').text;
const ranked = [...net.nodes].sort((a: any, b: any) => b.deg - a.deg);
const hubs = ranked.filter((x: any) => x.page).slice(0, 8);
const groupOf = Object.fromEntries(net.nodes.map((x: any) => [x.id, x.g]));
// Each island is named after its best-connected artist, skipping a name that would sit on one already placed.
const labelled: any[] = [];
for (const g of net.groups ?? []) {
  const y = (g.y + g.r) * H;
  if (labelled.every((o) => Math.abs(o.x - g.x) * H > 120 || Math.abs((o.y + o.r) * H - y) > 22)) labelled.push(g);
}

// Where artists live now: Iran, then the countries abroad, the smallest folded into one row.
const bs = d.based;
const COUNTRY_ROWS = 5;
const placeRows: [string, number, string][] = [[T('Iran', 'ایران'), bs.inside, 'var(--iran)']];
for (const [id, v] of bs.countries.slice(0, COUNTRY_ROWS)) placeRows.push([label(id), v, 'var(--coral)']);
const elsewhere = bs.countries.slice(COUNTRY_ROWS).reduce((t: number, [, v]: [string, number]) => t + v, 0);
if (elsewhere) placeRows.push([T('Elsewhere', 'جاهای دیگر'), elsewhere, 'var(--coral)']);
const placed = bs.inside + bs.abroad;
const left = byYear(bs.left);
const leftMax = scale(Math.max(1, ...left.map((s) => s.n)));

// Completeness.
const comp = d.completeness;
const fieldName: Record<string, [string, string]> = {
  photo: ['Photo', 'عکس'], 'official link': ['Official page or channel', 'صفحه یا کانال رسمی'], 'born or formed': ['Birth or formation date', 'تاریخ تولد یا شکل‌گیری'],
  'based in': ['Where they live and work', 'محل زندگی و کار'], 'life events': ['Life events', 'رویدادهای زندگی'],
  date: ['Release date', 'تاریخ انتشار آثار'], cover: ['Cover art', 'طرح جلد آثار'], 'listen link': ['Link to listen', 'پیوندهای شنیدن'],
  credits: ['Writers, producers and other credits', 'ترانه‌سرایان، آهنگ‌سازان، تهیه‌کنندگان و دیگر دست‌اندرکاران'], label: ['Label', 'ناشر'],
};
const fieldBars = (rows: [string, number, number][]) => rows.map(([k, v, t]) => ({ label: T(fieldName[k][0], fieldName[k][1]), width: pct(v, t), color: 'var(--copper)', value: p(v, t) }));
const langName: Record<string, [string, string]> = { en: ['English', 'انگلیسی'], fa: ['Persian', 'فارسی'], mul: ['Both or mixed', 'دوزبانه یا ترکیبی'], other: ['Other or not recorded', 'زبان‌های دیگر یا ثبت‌نشده'] };
const kindName: Record<string, [string, string]> = {
  own: ['The artists’ own pages and channels', 'صفحه‌ها و کانال‌های خود هنرمندان'], discography: ['Discographies and platforms', 'دیسکوگرافی‌ها و پلتفرم‌ها'], journalism: ['Journalism', 'رسانه‌ها و مطبوعات'],
  academic: ['Academic', 'پژوهش‌های دانشگاهی'], wikipedia: ['Wikipedia', 'ویکی‌پدیا'], other: ['Other', 'منابع دیگر'],
};
const langColors: Record<string, string> = { en: 'var(--iran)', fa: 'var(--coral)', mul: 'var(--copper)', other: 'var(--unknown)' };
const langParts = d.sources.langs.map(([k, v]: [string, number]) => ({ label: T(langName[k][0], langName[k][1]), v, c: langColors[k] }));
const kindMax = Math.max(1, ...d.sources.kinds.map((t: [string, number]) => t[1]));
// The archive's growth: sources gathered up to each week.
let running = 0;
const grown = d.pace.map(([w, v]: [string, number]) => ({ w, total: (running += v) }));
const grownMax = scale(running);
const week = (iso: string) => fmt({ day: 'numeric', month: 'short' }).format(new Date(iso + 'T12:00:00Z'));

// Sections the record cannot answer for enough of what they count stay off the page.
// Gender and labels join once the record holds them (see the spec); their counts are already in `stats`.
const sections = [
  { id: 'releases', label: T('Release records by year', 'مدخل‌های آثار به تفکیک سال'), show: d.releases.days.length > 0 },
  { id: 'new-artists', label: T('When artists started', 'آغاز کار هنرمندان'), show: d.starts.total > 0 && d.starts.days.length / d.starts.total >= SHOW_AT },
  { id: 'based', label: T('Inside Iran or abroad', 'داخل یا خارج ایران'), show: bs.total > 0 && bs.known / bs.total >= SHOW_AT },
  { id: 'left', label: T('When they left Iran', 'سال رفتن از ایران'), show: bs.total > 0 && bs.known / bs.total >= SHOW_AT && bs.left.length > 0 },
  { id: 'listen', label: T('Where to listen', 'کجا بشنویم'), show: ls.platforms.length >= 2 && ls.linked / ls.total >= SHOW_AT },
  { id: 'network', label: T('Who works with whom', 'همکاری‌ها'), show: net.nodes.length > 1 && hubs.length > 0 },
  { id: 'record', label: T('How complete the archive is', 'آرشیو چقدر کامل است'), show: true },
].filter((s) => s.show);
const shown = (id: string) => sections.some((s) => s.id === id);
// On wide screens these pairs sit side by side; a section whose partner is hidden keeps the full width.
const PAIRS = [['based', 'listen'], ['new-artists', 'left']];
const half = (id: string) => (PAIRS.some((pair) => pair.includes(id) && pair.every(shown)) ? ' q-half' : ' q-wide');
---

<Page lang={lang} title={title} description={description} path="stats/" section="stats">
  <main id="content" class="numbers wrap" tabindex="-1">
    <header class="numbers-head">
      <p class="kicker">{T(`Updated ${built}`, `به‌روزرسانی: ${built}`)}</p>
      <h1>{T('Naghva statistics', 'آمار نغوا')}</h1>
      <p class="deck">{T(
        'A look at the archive in numbers: who is in it, what they have released, and where the gaps are. It changes as the archive grows.',
        'نگاهی آماری به آرشیو: چه کسانی در آن هستند، چه منتشر کرده‌اند و کجاها هنوز خالی است. این آمار هم‌پای رشد آرشیو تغییر می‌کند.',
      )}</p>
      <dl class="totals">
        {[
          [d.totals.artists, T('artists with a page', 'هنرمند دارای صفحه')],
          [d.totals.releases, T('release records', 'مدخل آثار')],
          [d.totals.people, T('people credited', 'همکار و دست‌اندرکار')],
          [d.totals.events, T('events', 'رویداد')],
          [d.totals.sources, T('sources', 'منبع')],
        ].map(([v, l]) => <div><dt>{l}</dt><dd>{n(v as number)}</dd></div>)}
      </dl>
    </header>

    {shown('releases') && (
    <section class="q q-wide" id="releases" aria-labelledby="releases-h">
      <div class="q-text">
        <h2 id="releases-h">{T('Which years do these records cover?', 'مدخل‌های آرشیو مربوط به چه سال‌هایی هستند؟')}</h2>
      </div>
      <figure class="q-fig">
        <YearColumns lang={lang} years={rel} max={relScale} first={FIRST} grid={[1, .5, 0]} color="var(--coral)" unit={['entry', 'entries', 'مدخل']} earlierLabel={earlierLabel} open={nowYear} />
      </figure>
    </section>
    )}

    {shown('based') && (
      <section class={`q${half('based')}`} id="based" aria-labelledby="based-h">
        <div class="q-text">
          <h2 id="based-h">{T('Do they live in Iran or abroad?', 'در ایران زندگی می‌کنند یا بیرون از ایران؟')}</h2>
        </div>
        <figure class="q-fig">
          <HBars bars={placeRows.map(([name, v, c]) => ({ label: name, width: pct(v, placed), color: c, value: p(v, placed) }))} />
        </figure>
      </section>
    )}

    {shown('listen') && (
      <section class={`q${half('listen')}`} id="listen" aria-labelledby="listen-h">
        <div class="q-text">
          <h2 id="listen-h">{T('Where can it be heard?', 'آثار را کجا می‌توان شنید؟')}</h2>
        </div>
        <figure class="q-fig">
          <HBars bars={ls.platforms.map(([name, v]: [string, number]) => ({ label: strings(lang).platforms[name as PlatformKey] ?? name, width: pct(v, ls.total), color: 'var(--coral)', value: p(v, ls.total) }))} />
        </figure>
      </section>
    )}

    {shown('new-artists') && (
      <section class={`q${half('new-artists')}`} id="new-artists" aria-labelledby="new-artists-h">
        <div class="q-text">
          <h2 id="new-artists-h">{T('When did these artists start?', 'این هنرمندان از چه سالی کارشان را آغاز کردند؟')}</h2>
        </div>
        <figure class="q-fig">
          <YearColumns lang={lang} years={starts} max={startMax} first={FIRST} grid={[1, 0]} color="var(--iran)" unit={['artist', 'artists', 'هنرمند']} earlierLabel={earlierLabel} short />
        </figure>
      </section>
    )}

    {shown('left') && (
      <section class={`q${half('left')}`} id="left" aria-labelledby="left-h">
        <div class="q-text">
          <h2 id="left-h">{T('When did they leave Iran?', 'چه سالی از ایران رفتند؟')}</h2>
        </div>
        <figure class="q-fig">
          <YearColumns lang={lang} years={left} max={leftMax} first={FIRST} grid={[1, 0]} color="var(--coral)" unit={['artist', 'artists', 'هنرمند']} earlierLabel={earlierLabel} short />
        </figure>
      </section>
    )}

    {shown('network') && (
      <section class="q q-wide" id="network" aria-labelledby="network-h" data-with={T('Worked with {n}', 'همکاری با {n} نفر')} data-releases={T('Releases together', 'آثار مشترک')} data-none={T('No one by that name in the network', 'کسی با این نام در شبکه نیست')} data-digits={en ? 'en' : 'fa'}>
        <div class="q-text">
          <h2 id="network-h">{T('Who works with whom?', 'چه کسانی با هم کار می‌کنند؟')}</h2>
          <ul class="legend">
            <li style="--c:var(--coral)">{T('Artist with a page', 'هنرمند دارای صفحه')}</li>
            <li style="--c:rgb(247 243 232 / .45)">{T('Credited beside them', 'همکار و دست‌اندرکار')}</li>
          </ul>
        </div>
        <div class="net-ui">
          <div class="net-bar" hidden>
            <button type="button" class="net-btn net-close" aria-label={T('Close', 'بستن')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" /></svg></button>
            <label class="net-find">
              <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="M13 13l4.5 4.5" /></svg>
              <input type="search" class="net-q" placeholder={T('Find a name', 'جست‌وجوی نام')} aria-label={T('Find a name in the network', 'جست‌وجوی نام در شبکهٔ همکاری‌ها')} autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" role="combobox" aria-expanded="false" aria-controls="net-found" aria-autocomplete="list" />
            </label>
            <ul class="net-found" id="net-found" role="listbox" hidden></ul>
          </div>
          <figure class="net-wrap">
            <svg class="net-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={T('Collaboration network', 'شبکهٔ همکاری‌ها')}>
              <defs>
                <radialGradient id="net-glow"><stop offset="0" stop-color="#455bdb" stop-opacity=".2" /><stop offset=".7" stop-color="#455bdb" stop-opacity=".1" /><stop offset="1" stop-color="#455bdb" stop-opacity="0" /></radialGradient>
              </defs>
              <g class="isles">{(net.groups ?? []).map((g: any, i: number) => <circle data-g={i} data-lead={g.lead} cx={g.x * H} cy={g.y * H} r={g.r * H * 1.12} fill="url(#net-glow)" />)}</g>
              <g class="edges">{net.edges.map((e: any) => <line class={groupOf[e.s] === groupOf[e.t] ? undefined : 'far'} data-s={e.s} data-t={e.t} data-w={e.w} x1={pos(e.s).x} y1={pos(e.s).y} x2={pos(e.t).x} y2={pos(e.t).y} stroke-width={Math.min(2.4, .5 + Math.log2(1 + e.w) * .35)} />)}</g>
              <g class="nodes">
                {net.nodes.map((x: any) => {
                  const page = record.items[x.id]?.page;
                  return <circle class={x.page ? 'has-page' : undefined} data-id={x.id} data-g={x.g} data-name={label(x.id)} data-alt={other(x.id)} data-href={page ? url(lang, page) : undefined} cx={x.x * H} cy={x.y * H} r={x.r * H} />;
                })}
              </g>
            </svg>
            <div class="net-names" aria-hidden="true">
              {labelled.map((g) => <span style={`left:${(g.x * H / W) * 100}%;top:${(g.y + g.r) * 100}%`}>{label(g.lead)}</span>)}
            </div>
            <button type="button" class="net-btn net-expand" aria-label={T('Open full screen', 'باز کردن در تمام صفحه')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12 3h5v5M8 17H3v-5M17 3l-5.5 5.5M3 17l5.5-5.5" /></svg></button>
            <button type="button" class="net-btn net-out" aria-label={T('Show the whole network', 'نمایش کل شبکه')} hidden><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M17 3l-5 5m0-4v4h4M3 17l5-5m0 4v-4H4" /></svg></button>
          </figure>
          <div class="net-panel">
            <div class="net-who" hidden>
              <button type="button" class="net-btn net-shut" aria-label={T('Back to the whole network', 'بازگشت به کل شبکه')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12 4l-6 6 6 6" /></svg></button>
              <p class="net-name" aria-live="polite" tabindex="-1"></p>
              <a class="net-btn net-open" aria-label={T('Open their page', 'رفتن به صفحهٔ هنرمند')} title={T('Open their page', 'رفتن به صفحهٔ هنرمند')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5h8v8M15 5L5 15" /></svg></a>
            </div>
            <p class="fig-label net-cap"><span>{T('Most connected', 'بیشترین همکاری')}</span><span>{T('Collaborators', 'همکاران')}</span></p>
            <div class="net-scroll">
              <ul class="net-rows">{hubs.map((x: any) => <li><button type="button" class="has-page" data-pick={x.id}><span class="nr-name">{label(x.id)}</span><span class="nr-bar" style={`--w:${(x.deg / hubs[0].deg) * 100}%`}></span><span class="nr-val">{n(x.deg)}</span></button></li>)}</ul>
            </div>
          </div>
        </div>
        <div class="net-full" role="dialog" aria-modal="true" aria-label={T('Who works with whom?', 'چه کسانی با هم کار می‌کنند؟')} hidden></div>
      </section>
    )}

    <section class="q q-wide" id="record" aria-labelledby="record-h">
      <div class="q-text">
        <h2 id="record-h">{T('How complete is the archive?', 'آرشیو چقدر کامل است؟')}</h2>
      </div>
      <div class="record-grid">
        <figure>
          <p class="fig-label">{T(`Artists · ${d.totals.artists}`, `هنرمندان · ${n(d.totals.artists)}`)}</p>
          <HBars bars={fieldBars(comp.artists)} />
        </figure>
        <figure>
          <p class="fig-label">{T(`Release records · ${d.totals.releases}`, `مدخل‌های آثار · ${n(d.totals.releases)}`)}</p>
          <HBars bars={fieldBars(comp.releases)} />
        </figure>
        <figure>
          <p class="fig-label">{T(`Sources by language · ${d.totals.sources}`, `منابع به تفکیک زبان · ${n(d.totals.sources)}`)}</p>
          <div class="split">{langParts.map((x: any) => x.v > 0 && <i style={`--c:${x.c};flex-grow:${x.v}`} title={x.label}><span>{p(x.v, d.totals.sources)}</span></i>)}</div>
          <ul class="legend">{langParts.map((x: any) => <li style={`--c:${x.c}`}>{x.label}</li>)}</ul>
          <p class="fig-label">{T('Sources by kind', 'منابع به تفکیک نوع')}</p>
          <HBars tight bars={d.sources.kinds.map(([k, v]: [string, number]) => ({ label: T(kindName[k][0], kindName[k][1]), width: (v / kindMax) * 100, color: 'var(--sage)', value: n(v) }))} />
        </figure>
        <figure>
          <p class="fig-label">{T('How the archive has grown: sources gathered, week by week', 'روند رشد آرشیو: منابع گردآوری‌شده در هر هفته')}</p>
          <div class="cols cols-short cols-pace" dir="ltr" style={`--n:${grown.length}`}>
            {grown.map((g: any) => (
              <div class="col" title={`${week(g.w)}: ${n(g.total)}`} style={`--h:${(g.total / grownMax) * 100}%`}>
                <span class="col-val">{n(g.total)}</span>
                <div class="stack"><i style="--c:var(--sage);flex-grow:1"></i></div>
                <span class="tick">{week(g.w)}</span>
              </div>
            ))}
          </div>
        </figure>
      </div>
    </section>

    <aside class="numbers-foot">
      <p>{T(
        'These numbers describe Naghva’s archive, not the whole scene: an artist or release that is missing here is missing from the archive, not from history. Each chart says how much of the archive it rests on.',
        'این آمارها تنها آرشیو نغوا را توصیف می‌کند، نه تمام موسیقی مستقل ایران را؛ اگر هنرمند یا اثری اینجا نیست، از آرشیو ما جا مانده است، نه از تاریخ. در کنار هر نمودار آمده است که بر چه بخشی از آرشیو تکیه دارد.',
      )}</p>
      <p><a class="text-link" href={REPOSITORY}>{T('The archive is open data on GitHub', 'داده‌های آرشیو در گیت‌هاب آزاد و در دسترس همگان است')}</a></p>
    </aside>
  </main>
  <script>
    import '../../scripts/network';
    import '../../scripts/year-columns';
  </script>
</Page>
