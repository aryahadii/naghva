---
import Page from '../../layouts/Page.astro';
import { partsOf } from '../../lib/dates';
import { num } from '../../lib/i18n';
import { LANGS, loadRecord, nameOf, url, type Lang } from '../../lib/record';
import '../../styles/stats.css';

/** Statistics: what the record holds and how complete it is, counted at build time. */
export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const en = lang === 'en';
const record = loadRecord();
const d = record.stats;
const T = (e: string, f: string) => (en ? e : f);
const n = (x: number) => num(lang, x);
const pct = (a: number, b: number) => (b ? Math.round((a / b) * 100) : 0);
const p = (a: number, b: number) => (en ? `${pct(a, b)}%` : `٪${n(pct(a, b))}`);
/** A section shows once the field it counts covers this share of what it counts. */
const SHOW_AT = 0.3;

const title = T('Naghva statistics | What the archive holds', 'آمار نغوا | آنچه در آرشیو هست');
const description = T(
  'Naghva’s archive in numbers: releases by year, when artists started, where the music can be heard, who works with whom, and where the gaps are.',
  'آرشیو نغوا به روایت آمار: آثار منتشرشده در هر سال، زمان آغاز کار هنرمندان، جاهایی که می‌شود این موسیقی را شنید، شبکهٔ همکاری‌ها و جاهای خالی آرشیو.',
);
const fmt = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(en ? 'en-GB' : 'fa-IR-u-ca-persian', { ...o, timeZone: 'UTC' });
const built = fmt({ day: 'numeric', month: 'long', year: 'numeric' }).format(new Date());

// Years in the page's calendar, one column per year for the last 26 years; anything older
// is one "earlier" column, so a few early releases don't stretch the axis across decades.
const nowYear = partsOf(new Date().toISOString().slice(0, 10), lang).y;
const FIRST = nowYear - 26;
const byYear = (days: string[]) => {
  const counts = new Map<number, number>();
  let earlier = 0;
  for (const day of days) {
    const y = partsOf(day, lang).y;
    if (y < FIRST) earlier++;
    else counts.set(y, (counts.get(y) ?? 0) + 1);
  }
  const years = Array.from({ length: nowYear - FIRST + 1 }, (_, i) => ({ y: FIRST + i, n: counts.get(FIRST + i) ?? 0, earlier: false }));
  return earlier ? [{ y: FIRST - 1, n: earlier, earlier: true }, ...years] : years;
};
const earlierLabel = T('Earlier', 'پیش‌تر');
const scale = (max: number) => {
  const step = max > 100 ? 50 : max > 40 ? 20 : max > 10 ? 5 : 2;
  return Math.ceil(max / step) * step;
};

// Releases per year. Releases before 1995 are few; they still count, and the axis starts at the first.
const rel = byYear(d.releases.days);
const relScale = scale(Math.max(1, ...rel.map((r) => r.n)));

// When artists started.
const starts = byYear(d.starts.days);
const startMax = scale(Math.max(1, ...starts.map((s) => s.n)));

// Listening.
const ls = d.listen;

// Network.
const net = d.network;
const W = 1000, H = 560, pad = 28;
const pos = Object.fromEntries(net.nodes.map((x: any) => [x.id, { x: pad + x.x * (W - 2 * pad), y: pad + x.y * (H - 2 * pad) }]));
const rad = (deg: number) => 2.2 + Math.sqrt(deg) * 1.25;
const label = (id: string) => nameOf(record.items[id], lang).text;
const ranked = [...net.nodes].sort((a: any, b: any) => b.deg - a.deg);
const hubs = ranked.filter((x: any) => x.page).slice(0, 3);
// Name the best-connected dots, skipping any whose label would sit on one already placed.
const labelled: any[] = [];
for (const x of ranked) {
  const q = pos[x.id];
  if (labelled.every((o) => Math.abs(pos[o.id].x - q.x) > 130 || Math.abs(pos[o.id].y - q.y) > 30)) labelled.push(x);
  if (labelled.length === 10) break;
}

// Where artists live now: Iran, then the countries abroad, the smallest folded into one row.
const bs = d.based;
const COUNTRY_ROWS = 5;
const placeRows: [string, number, string][] = [[T('Iran', 'ایران'), bs.inside, 'var(--iran)']];
for (const [id, v] of bs.countries.slice(0, COUNTRY_ROWS)) placeRows.push([label(id), v, 'var(--coral)']);
const elsewhere = bs.countries.slice(COUNTRY_ROWS).reduce((t: number, [, v]: [string, number]) => t + v, 0);
if (elsewhere) placeRows.push([T('Elsewhere', 'جاهای دیگر'), elsewhere, 'var(--coral)']);
const placed = bs.inside + bs.abroad;
const left = byYear(bs.left);
const leftMax = scale(Math.max(1, ...left.map((s) => s.n)));

// Completeness.
const comp = d.completeness;
const fieldName: Record<string, [string, string]> = {
  photo: ['Photo', 'عکس'], 'official link': ['Official page or channel', 'صفحه یا کانال رسمی'], 'born or formed': ['Birth or formation date', 'تاریخ تولد یا شکل‌گیری'],
  'based in': ['Where they live and work', 'محل زندگی و کار'], 'life events': ['Life events', 'رویدادهای زندگی'],
  date: ['Release date', 'تاریخ انتشار آثار'], cover: ['Cover art', 'طرح جلد آثار'], 'listen link': ['Link to listen', 'پیوندهای شنیدن'],
  credits: ['Writers, producers and other credits', 'ترانه‌سرایان، آهنگ‌سازان، تهیه‌کنندگان و دیگر دست‌اندرکاران'], label: ['Label', 'ناشر'],
};
const langName: Record<string, [string, string]> = { en: ['English', 'انگلیسی'], fa: ['Persian', 'فارسی'], mul: ['Both or mixed', 'دوزبانه یا ترکیبی'], other: ['Other or not recorded', 'زبان‌های دیگر یا ثبت‌نشده'] };
const kindName: Record<string, [string, string]> = {
  own: ['The artists’ own pages and channels', 'صفحه‌ها و کانال‌های خود هنرمندان'], discography: ['Discographies and platforms', 'دیسکوگرافی‌ها و پلتفرم‌ها'], journalism: ['Journalism', 'رسانه‌ها و مطبوعات'],
  academic: ['Academic', 'پژوهش‌های دانشگاهی'], wikipedia: ['Wikipedia', 'ویکی‌پدیا'], other: ['Other', 'منابع دیگر'],
};
const langColors: Record<string, string> = { en: 'var(--iran)', fa: 'var(--coral)', mul: 'var(--copper)', other: 'var(--unknown)' };
const langParts = d.sources.langs.map(([k, v]: [string, number]) => ({ label: T(langName[k][0], langName[k][1]), v, c: langColors[k] }));
const kindMax = Math.max(1, ...d.sources.kinds.map((t: [string, number]) => t[1]));
// The archive's growth: sources gathered up to each week.
let running = 0;
const grown = d.pace.map(([w, v]: [string, number]) => ({ w, total: (running += v) }));
const grownMax = scale(running);
const week = (iso: string) => fmt({ day: 'numeric', month: 'short' }).format(new Date(iso + 'T12:00:00Z'));

// Sections the record cannot answer for enough of what they count stay off the page.
// Gender and labels join once the record holds them (see the spec); their counts are already in `stats`.
const sections = [
  { id: 'releases', label: T('Releases per year', 'انتشار در هر سال'), show: d.releases.days.length > 0 },
  { id: 'new-artists', label: T('When artists started', 'آغاز کار هنرمندان'), show: d.starts.total > 0 && d.starts.days.length / d.starts.total >= SHOW_AT },
  { id: 'based', label: T('Inside Iran or abroad', 'داخل یا خارج ایران'), show: bs.total > 0 && bs.known / bs.total >= SHOW_AT },
  { id: 'left', label: T('When they left Iran', 'سال رفتن از ایران'), show: bs.total > 0 && bs.known / bs.total >= SHOW_AT && bs.left.length > 0 },
  { id: 'listen', label: T('Where to listen', 'کجا بشنویم'), show: ls.platforms.length >= 2 && ls.linked / ls.total >= SHOW_AT },
  { id: 'network', label: T('Who works with whom', 'همکاری‌ها'), show: net.nodes.length > 1 && hubs.length > 0 },
  { id: 'record', label: T('How complete the archive is', 'آرشیو چقدر کامل است'), show: true },
].filter((s) => s.show);
const shown = (id: string) => sections.some((s) => s.id === id);
// On wide screens these pairs sit side by side; a section whose partner is hidden keeps the full width.
const PAIRS = [['based', 'listen'], ['new-artists', 'left']];
const half = (id: string) => (PAIRS.some((pair) => pair.includes(id) && pair.every(shown)) ? ' q-half' : ' q-wide');
---

<Page lang={lang} title={title} description={description} path="stats/" section="stats">
  <main id="content" class="numbers wrap" tabindex="-1">
    <header class="numbers-head">
      <p class="kicker">{T(`Updated ${built}`, `به‌روزرسانی: ${built}`)}</p>
      <h1>{T('Naghva statistics', 'آمار نغوا')}</h1>
      <p class="deck">{T(
        'A look at the archive in numbers: who is in it, what they have released, and where the gaps are. It changes as the archive grows.',
        'نگاهی آماری به آرشیو: چه کسانی در آن هستند، چه منتشر کرده‌اند و کجاها هنوز خالی است. این آمار هم‌پای رشد آرشیو تغییر می‌کند.',
      )}</p>
      <dl class="totals">
        {[
          [d.totals.artists, T('artists with a page', 'هنرمند دارای صفحه')],
          [d.totals.releases, T('releases', 'اثر منتشرشده')],
          [d.totals.people, T('people credited', 'همکار و دست‌اندرکار')],
          [d.totals.events, T('events', 'رویداد')],
          [d.totals.sources, T('sources', 'منبع')],
        ].map(([v, l]) => <div><dt>{l}</dt><dd>{n(v as number)}</dd></div>)}
      </dl>
    </header>

    {shown('releases') && (
    <section class="q q-wide" id="releases" aria-labelledby="releases-h">
      <div class="q-text">
        <h2 id="releases-h">{T('How much comes out each year?', 'هر سال چند اثر منتشر می‌شود؟')}</h2>
      </div>
      <figure class="q-fig">
        <div class="cols" dir="ltr" style={`--n:${rel.length}`}>
          <div class="grid" aria-hidden="true">{[1, .5, 0].map((k) => <span style={`--k:${k}`}><b>{n(Math.round(relScale * k))}</b></span>)}</div>
          {rel.map((r) => (
            <div class={`col${r.y === nowYear ? ' col-open' : ''}${r.earlier ? ' col-earlier' : ''}`} tabindex="0" role="button" data-tip={`${r.earlier ? earlierLabel : n(r.y)}: ${n(r.n)} ${T(r.n === 1 ? 'release' : 'releases', 'اثر')}`} aria-label={`${r.earlier ? earlierLabel : n(r.y)}: ${n(r.n)}`} style={`--h:${(r.n / relScale) * 100}%`}>
              <div class="stack"><i style="--c:var(--coral);flex-grow:1"></i></div>
              {r.earlier ? <span class="tick">{earlierLabel}</span> : r.y % 5 === 0 && r.y - FIRST > 2 && <span class={`tick${r.y % 10 ? ' tick-minor' : ''}`}>{n(r.y)}</span>}
            </div>
          ))}
        </div>
      </figure>
    </section>
    )}

    {shown('based') && (
      <section class={`q${half('based')}`} id="based" aria-labelledby="based-h">
        <div class="q-text">
          <h2 id="based-h">{T('Do they live in Iran or abroad?', 'در ایران زندگی می‌کنند یا بیرون از ایران؟')}</h2>
        </div>
        <figure class="q-fig">
          <ul class="hbars">
            {placeRows.map(([name, v, c]) => (
              <li><span class="hb-label">{name}</span><span class="hb-bar" style={`--w:${pct(v, placed)}%;--c:${c}`}></span><span class="hb-val">{p(v, placed)}</span></li>
            ))}
          </ul>
        </figure>
      </section>
    )}

    {shown('listen') && (
      <section class={`q${half('listen')}`} id="listen" aria-labelledby="listen-h">
        <div class="q-text">
          <h2 id="listen-h">{T('Where can it be heard?', 'آثار را کجا می‌توان شنید؟')}</h2>
        </div>
        <figure class="q-fig">
          <ul class="hbars">
            {ls.platforms.map(([name, v]: [string, number]) => (
              <li><span class="hb-label" dir="ltr">{name}</span><span class="hb-bar" style={`--w:${pct(v, ls.total)}%;--c:var(--coral)`}></span><span class="hb-val">{p(v, ls.total)}</span></li>
            ))}
          </ul>
        </figure>
      </section>
    )}

    {shown('new-artists') && (
      <section class={`q${half('new-artists')}`} id="new-artists" aria-labelledby="new-artists-h">
        <div class="q-text">
          <h2 id="new-artists-h">{T('When did these artists start?', 'این هنرمندان از چه سالی کارشان را آغاز کردند؟')}</h2>
        </div>
        <figure class="q-fig">
          <div class="cols cols-short" dir="ltr" style={`--n:${starts.length}`}>
            <div class="grid" aria-hidden="true">{[1, 0].map((k) => <span style={`--k:${k}`}><b>{n(Math.round(startMax * k))}</b></span>)}</div>
            {starts.map((s) => (
              <div class={`col${s.earlier ? ' col-earlier' : ''}`} tabindex="0" role="button" data-tip={`${s.earlier ? earlierLabel : n(s.y)}: ${n(s.n)} ${T(s.n === 1 ? 'artist' : 'artists', 'هنرمند')}`} aria-label={`${s.earlier ? earlierLabel : n(s.y)}: ${n(s.n)}`} style={`--h:${(s.n / startMax) * 100}%`}>
                <div class="stack"><i style="--c:var(--iran);flex-grow:1"></i></div>
                {s.earlier ? <span class="tick">{earlierLabel}</span> : s.y % 5 === 0 && s.y - FIRST > 2 && <span class={`tick${s.y % 10 ? ' tick-minor' : ''}`}>{n(s.y)}</span>}
              </div>
            ))}
          </div>
        </figure>
      </section>
    )}

    {shown('left') && (
      <section class={`q${half('left')}`} id="left" aria-labelledby="left-h">
        <div class="q-text">
          <h2 id="left-h">{T('When did they leave Iran?', 'چه سالی از ایران رفتند؟')}</h2>
        </div>
        <figure class="q-fig">
          <div class="cols cols-short" dir="ltr" style={`--n:${left.length}`}>
            <div class="grid" aria-hidden="true">{[1, 0].map((k) => <span style={`--k:${k}`}><b>{n(Math.round(leftMax * k))}</b></span>)}</div>
            {left.map((s) => (
              <div class={`col${s.earlier ? ' col-earlier' : ''}`} tabindex="0" role="button" data-tip={`${s.earlier ? earlierLabel : n(s.y)}: ${n(s.n)} ${T(s.n === 1 ? 'artist' : 'artists', 'هنرمند')}`} aria-label={`${s.earlier ? earlierLabel : n(s.y)}: ${n(s.n)}`} style={`--h:${(s.n / leftMax) * 100}%`}>
                <div class="stack"><i style="--c:var(--coral);flex-grow:1"></i></div>
                {s.earlier ? <span class="tick">{earlierLabel}</span> : s.y % 5 === 0 && s.y - FIRST > 2 && <span class={`tick${s.y % 10 ? ' tick-minor' : ''}`}>{n(s.y)}</span>}
              </div>
            ))}
          </div>
        </figure>
      </section>
    )}

    {shown('network') && (
      <section class="q q-wide" id="network" aria-labelledby="network-h">
        <div class="q-text">
          <h2 id="network-h">{T('Who works with whom?', 'چه کسانی با هم کار می‌کنند؟')}</h2>
          <ul class="legend">
            <li style="--c:var(--coral)">{T('Artist with a page', 'هنرمند دارای صفحه')}</li>
            <li style="--c:rgb(247 243 232 / .45)">{T('Credited beside them', 'همکار و دست‌اندرکار')}</li>
          </ul>
        </div>
        <figure class="q-fig net">
          <div class="net-wrap">
            <svg class="net-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={T('Collaboration network', 'شبکهٔ همکاری‌ها')}>
              <defs>
                <radialGradient id="net-glow"><stop offset="0" stop-color="#455bdb" stop-opacity=".16" /><stop offset="1" stop-color="#455bdb" stop-opacity="0" /></radialGradient>
              </defs>
              <ellipse cx={W / 2} cy={H / 2} rx={W / 2} ry={H / 2} fill="url(#net-glow)" />
              <g class="edges">{net.edges.map((e: any) => <line data-s={e.s} data-t={e.t} data-w={e.w} x1={pos[e.s].x} y1={pos[e.s].y} x2={pos[e.t].x} y2={pos[e.t].y} stroke-width={Math.min(2.4, .5 + Math.log2(1 + e.w) * .35)} />)}</g>
              <g class="nodes">
                {net.nodes.map((x: any) => {
                  const page = record.items[x.id]?.page;
                  return <circle data-id={x.id} data-name={label(x.id)} data-href={page ? url(lang, page) : undefined} cx={pos[x.id].x} cy={pos[x.id].y} r={rad(x.deg)} fill={x.page ? 'var(--coral)' : 'rgb(247 243 232 / .5)'} />;
                })}
              </g>
            </svg>
            <button type="button" class="net-expand" aria-label={T('Open full screen', 'باز کردن در تمام صفحه')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12 3h5v5M8 17H3v-5M17 3l-5.5 5.5M3 17l5.5-5.5" /></svg></button>
            <div class="net-labels" aria-hidden="true">
              {labelled.map((x) => <span data-for={x.id} style={`left:${(pos[x.id].x / W) * 100}%;top:${(pos[x.id].y / H) * 100}%;--r:${rad(x.deg)}`}>{label(x.id)}</span>)}
            </div>
            <div class="net-card" aria-live="polite" hidden>
              <button type="button" class="net-shut" aria-label={T('Close', 'بستن')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg></button>
              <p class="net-name"></p>
              <p class="net-with"></p>
              <a class="text-link net-open" hidden>{T('Open their page', 'رفتن به صفحهٔ هنرمند')}</a>
            </div>
          </div>
        </figure>
        <div class="net-top">
          <p class="fig-label">{T('Most connected', 'بیشترین همکاری')}</p>
          <ul class="net-chips">{ranked.filter((x: any) => x.page).slice(0, 8).map((x: any) => <li><button type="button" data-pick={x.id}>{label(x.id)}</button></li>)}</ul>
        </div>
        <div class="net-full" role="dialog" aria-modal="true" aria-labelledby="nf-title" hidden>
          <div class="nf-bar">
            <p class="nf-title" id="nf-title">{T('Who works with whom?', 'چه کسانی با هم کار می‌کنند؟')}</p>
            <button type="button" class="nf-close" aria-label={T('Close', 'بستن')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" /></svg></button>
          </div>
          <div class="nf-stage">
            <div class="nf-names" aria-hidden="true"></div>
            <button type="button" class="net-out" hidden>{T('Show all', 'نمایش کل')}</button>
          </div>
          <div class="nf-sheet"></div>
        </div>
      </section>
    )}

    <section class="q q-wide" id="record" aria-labelledby="record-h">
      <div class="q-text">
        <h2 id="record-h">{T('How complete is the archive?', 'آرشیو چقدر کامل است؟')}</h2>
      </div>
      <div class="record-grid">
        <figure>
          <p class="fig-label">{T(`Artists · ${d.totals.artists}`, `هنرمندان · ${n(d.totals.artists)}`)}</p>
          <ul class="hbars">{comp.artists.map(([k, v, t]: [string, number, number]) => <li><span class="hb-label">{T(fieldName[k][0], fieldName[k][1])}</span><span class="hb-bar" style={`--w:${pct(v, t)}%;--c:var(--copper)`}></span><span class="hb-val">{p(v, t)}</span></li>)}</ul>
        </figure>
        <figure>
          <p class="fig-label">{T(`Releases · ${d.totals.releases}`, `آثار · ${n(d.totals.releases)}`)}</p>
          <ul class="hbars">{comp.releases.map(([k, v, t]: [string, number, number]) => <li><span class="hb-label">{T(fieldName[k][0], fieldName[k][1])}</span><span class="hb-bar" style={`--w:${pct(v, t)}%;--c:var(--copper)`}></span><span class="hb-val">{p(v, t)}</span></li>)}</ul>
        </figure>
        <figure>
          <p class="fig-label">{T(`Sources by language · ${d.totals.sources}`, `منابع به تفکیک زبان · ${n(d.totals.sources)}`)}</p>
          <div class="split">{langParts.map((x: any) => x.v > 0 && <i style={`--c:${x.c};flex-grow:${x.v}`} title={x.label}><span>{p(x.v, d.totals.sources)}</span></i>)}</div>
          <ul class="legend">{langParts.map((x: any) => <li style={`--c:${x.c}`}>{x.label}</li>)}</ul>
          <p class="fig-label">{T('Sources by kind', 'منابع به تفکیک نوع')}</p>
          <ul class="hbars hbars-tight">{d.sources.kinds.map(([k, v]: [string, number]) => <li><span class="hb-label">{T(kindName[k][0], kindName[k][1])}</span><span class="hb-bar" style={`--w:${(v / kindMax) * 100}%;--c:var(--sage)`}></span><span class="hb-val">{n(v)}</span></li>)}</ul>
        </figure>
        <figure>
          <p class="fig-label">{T('How the archive has grown: sources gathered, week by week', 'روند رشد آرشیو: منابع گردآوری‌شده در هر هفته')}</p>
          <div class="cols cols-short cols-pace" dir="ltr" style={`--n:${grown.length}`}>
            {grown.map((g: any) => (
              <div class="col" title={`${week(g.w)}: ${n(g.total)}`} style={`--h:${(g.total / grownMax) * 100}%`}>
                <span class="col-val">{n(g.total)}</span>
                <div class="stack"><i style="--c:var(--sage);flex-grow:1"></i></div>
                <span class="tick">{week(g.w)}</span>
              </div>
            ))}
          </div>
        </figure>
      </div>
    </section>

    <aside class="numbers-foot">
      <p>{T(
        'These numbers describe Naghva’s archive, not the whole scene: an artist or release that is missing here is missing from the archive, not from history. Each chart says how much of the archive it rests on.',
        'این آمارها تنها آرشیو نغوا را توصیف می‌کند، نه تمام موسیقی مستقل ایران را؛ اگر هنرمند یا اثری اینجا نیست، از آرشیو ما جا مانده است، نه از تاریخ. در کنار هر نمودار آمده است که بر چه بخشی از آرشیو تکیه دارد.',
      )}</p>
      <p><a class="text-link" href="https://github.com/aryahadii/naghva">{T('The archive is open data on GitHub', 'داده‌های آرشیو در گیت‌هاب آزاد و در دسترس همگان است')}</a></p>
    </aside>
  </main>
  <script is:inline define:vars={{ words: { with: T('Worked with', 'همکاری با'), more: T('more', 'نفر دیگر'), sep: en ? ', ' : '، ', digits: en ? 'en' : 'fa' } }}>
    // The network. With a mouse, hover or click picks the nearest dot. On a phone the page holds a still preview;
    // a tap opens it full screen, where a pinch zooms, a drag moves, a tap picks a dot and Back closes it.
    (() => {
      const fig = document.querySelector('.net');
      const svg = fig?.querySelector('svg.net-svg');
      const wrap = fig?.querySelector('.net-wrap');
      const card = document.querySelector('.net-card');
      const top = document.querySelector('.net-top');
      const full = document.querySelector('.net-full');
      if (!fig || !svg || !wrap || !card || !top || !full) return;
      const stage = full.querySelector('.nf-stage'), sheet = full.querySelector('.nf-sheet'), names = full.querySelector('.nf-names');
      const out = full.querySelector('.net-out'), shut = full.querySelector('.nf-close'), expand = fig.querySelector('.net-expand');
      const dots = [...svg.querySelectorAll('circle[data-id]')];
      const lines = [...svg.querySelectorAll('line[data-s]')];
      const byId = new Map(dots.map((c) => [c.dataset.id, c]));
      const fmt = new Intl.NumberFormat(words.digits === 'fa' ? 'fa-IR' : 'en');
      const nameEl = card.querySelector('.net-name'), withEl = card.querySelector('.net-with'), link = card.querySelector('.net-open');
      const phone = matchMedia('(max-width: 640px)');
      const [, , W0, H0] = svg.getAttribute('viewBox').split(' ').map(Number);
      let W = W0, H = H0, upright = false, isOpen = false;
      const X = (c) => +c.getAttribute('cx'), Y = (c) => +c.getAttribute('cy'), R = (c) => +c.getAttribute('r');
      // Biggest dots first: they get their names first.
      const bySize = [...dots].sort((a, b) => R(b) - R(a));

      // Turn the picture upright (or back): swap every x with its y.
      const turn = () => {
        const swap = (el, a, b) => { const v = el.getAttribute(a); el.setAttribute(a, el.getAttribute(b)); el.setAttribute(b, v); };
        dots.forEach((c) => swap(c, 'cx', 'cy'));
        lines.forEach((l) => { swap(l, 'x1', 'y1'); swap(l, 'x2', 'y2'); });
        const glow = svg.querySelector('ellipse');
        if (glow) { swap(glow, 'cx', 'cy'); swap(glow, 'rx', 'ry'); }
        [W, H] = [H, W];
        upright = !upright;
      };

      // `picked` is a dot chosen by click or tap; a dot only hovered is shown (`cur`) but not picked.
      let picked = null, cur = null, near = [];
      const show = (dot, peek = false) => {
        picked = peek ? null : dot;
        cur = dot;
        near = [];
        svg.classList.toggle('has-sel', !!dot);
        fig.classList.toggle('has-sel', !!dot);
        full.classList.toggle('has-sel', !!dot);
        dots.forEach((c) => c.classList.remove('is-sel', 'is-near'));
        lines.forEach((l) => l.classList.remove('is-on'));
        document.querySelectorAll('[data-pick]').forEach((x) => x.classList.toggle('is-on', !!dot && x.dataset.pick === dot.dataset.id));
        card.hidden = !dot;
        card.classList.toggle('is-peek', !!dot && peek);
        if (!dot) { placeNames(); return; }
        const id = dot.dataset.id;
        for (const l of lines) {
          const other = l.dataset.s === id ? l.dataset.t : l.dataset.t === id ? l.dataset.s : null;
          if (!other) continue;
          l.classList.add('is-on');
          byId.get(other)?.classList.add('is-near');
          near.push([other, +l.dataset.w]);
        }
        dot.classList.add('is-sel');
        near.sort((a, b) => b[1] - a[1]);
        nameEl.textContent = dot.dataset.name;
        // Who they worked with, as names to tap: each one moves the selection to that person.
        withEl.replaceChildren();
        if (near.length) {
          withEl.append(`${words.with}: `);
          near.slice(0, 8).forEach(([other], i) => {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'net-hop'; b.textContent = byId.get(other)?.dataset.name ?? '';
            b.addEventListener('click', () => { const d = byId.get(other); show(d); if (d && isOpen) focusOn(d); });
            if (i) withEl.append(words.sep);
            withEl.append(b);
          });
          if (near.length > 8) withEl.append(`${words.sep}+${fmt.format(near.length - 8)} ${words.more}`);
        }
        link.hidden = !dot.dataset.href;
        if (dot.dataset.href) link.href = dot.dataset.href;
        placeNames();
        place();
      };

      // In the page, the card stands beside its dot: on the side with room that hides the fewest of the dot's
      // neighbours, inside the picture, and inside the window too when the dot is on screen and the card fits there.
      const place = () => {
        if (!cur || isOpen || card.hidden || card.parentElement !== wrap) return;
        const w = wrap.getBoundingClientRect(), m = svg.getScreenCTM();
        if (!m) return;
        const spot = (c) => { const q = new DOMPoint(X(c), Y(c)).matrixTransform(m); return [q.x - w.left, q.y - w.top]; };
        const [cx, cy] = spot(cur), gap = R(cur) * m.a + 12, edge = 8;
        const cw = card.offsetWidth, ch = card.offsetHeight;
        const left = edge, right = w.width - edge;
        let top = edge, bottom = w.height - edge;
        const vt = Math.max(top, edge - w.top), vb = Math.min(bottom, innerHeight - edge - w.top);
        if (cy > vt && cy < vb && vb - vt >= ch) { top = vt; bottom = vb; }
        const cX = (x) => Math.min(Math.max(x, left), right - cw), cY = (y) => Math.min(Math.max(y, top), bottom - ch);
        // Beside it (level with it, or reaching up or down from it), then under or over it (centred, or to a side).
        const rtl = getComputedStyle(wrap).direction === 'rtl';
        const xs = rtl ? [cx - gap - cw, cx + gap] : [cx + gap, cx - gap - cw];
        const ys = [cy + gap, cy - gap - ch];
        const spots = [
          ...xs.flatMap((x) => [[x, cY(cy - ch / 2)], [x, cy - gap / 2], [x, cy + gap / 2 - ch]]),
          ...ys.flatMap((y) => [[cX(cx - cw / 2), y], [cX(cx - 24), y], [cX(cx + 24 - cw), y]]),
        ].filter(([x, y]) => x >= left && x + cw <= right && y >= top && y + ch <= bottom);
        const lit = near.map(([o]) => byId.get(o)).filter(Boolean).map(spot);
        const under = ([x, y], [a, b]) => a > x - 8 && a < x + cw + 8 && b > y - 8 && b < y + ch + 8;
        const covers = (s) => (under(s, [cx, cy]) ? 1e3 : 0) + lit.filter((q) => under(s, q)).length;
        let best = spots[0] ?? [cX(cx + gap), cY(cy + gap)];
        for (const s of spots) if (covers(s) < covers(best)) best = s;
        card.style.left = `${best[0]}px`;
        card.style.top = `${best[1]}px`;
      };
      new ResizeObserver(place).observe(wrap);
      // When a name below the picture picks a dot that is off screen, bring the dot and its card into view.
      const reveal = () => {
        if (!picked || card.hidden) return;
        const a = card.getBoundingClientRect(), d = picked.getBoundingClientRect();
        const t = Math.min(a.top, d.top) - 16, b = Math.max(a.bottom, d.bottom) + 16;
        if (t < 0) scrollBy({ top: t, behavior: 'smooth' });
        else if (b > innerHeight) scrollBy({ top: Math.min(b - innerHeight, t), behavior: 'smooth' });
      };

      // Where a pointer is, in the picture's own units, and how many units a screen pixel is right now.
      const at = (e) => {
        const m = svg.getScreenCTM();
        return m ? new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse()) : null;
      };
      const unit = () => +svg.getAttribute('viewBox').split(' ')[2] / svg.getBoundingClientRect().width;
      // The nearest dot within `px` screen pixels of its edge.
      const nearest = (e, px) => {
        const p = at(e);
        if (!p) return null;
        let best = null, bestD = Infinity;
        for (const c of dots) {
          const d = Math.hypot(X(c) - p.x, Y(c) - p.y) - R(c);
          if (d < bestD) { bestD = d; best = c; }
        }
        return bestD <= px * unit() ? best : null;
      };

      // Full screen: the visible part of the picture always has the stage's shape, so nothing is letterboxed.
      const MAX = 7;
      let view = [0, 0, W, H], base = view, anim = 0;
      const fit = () => {
        const r = stage.getBoundingClientRect(), a = r.width / r.height;
        let w = W * 1.04, h = H * 1.04;
        if (w / h > a) h = w / a; else w = h * a;
        return [(W - w) / 2, (H - h) / 2, w, h];
      };
      const clamp = ([x, y, w]) => {
        w = Math.min(Math.max(w, base[2] / MAX), base[2]);
        const h = w * (base[3] / base[2]);
        x = w >= W ? (W - w) / 2 : Math.min(Math.max(x, -w * .1), W - w * .9);
        y = h >= H ? (H - h) / 2 : Math.min(Math.max(y, -h * .1), H - h * .9);
        return [x, y, w, h];
      };
      // Dots grow more slowly than the picture, so zooming in spreads them apart instead of blowing them up.
      const r0 = new Map(dots.map((c) => [c, R(c)]));
      let lastK = 1;
      const size = (k) => {
        if (Math.abs(k - lastK) < .002) return;
        lastK = k;
        for (const [c, r] of r0) c.setAttribute('r', (r * k).toFixed(2));
      };
      const setView = (v) => {
        view = v;
        svg.setAttribute('viewBox', v.map((x) => x.toFixed(2)).join(' '));
        size(1.5 * (base[2] / v[2]) ** -.4);
        out.hidden = v[2] > base[2] * .97;
        placeNames();
      };
      const glide = (to) => {
        cancelAnimationFrame(anim);
        const from = view, t0 = performance.now();
        const step = (t) => {
          const k = Math.min(1, (t - t0) / 260), e = 1 - (1 - k) ** 3;
          setView(from.map((a, i) => a + (to[i] - a) * e));
          if (k < 1) anim = requestAnimationFrame(step);
        };
        anim = requestAnimationFrame(step);
      };
      // Bring a dot to the middle, zoomed in enough to tell its neighbours apart.
      const focusOn = (d) => {
        const w = Math.min(view[2], base[2] / 2.6), h = w * (base[3] / base[2]);
        glide(clamp([X(d) - w / 2, Y(d) - h / 2, w]));
      };

      // Names on the full-screen picture: the chosen person and their circle, or as many of the biggest dots as fit
      // without overlapping. Zooming in makes room for more.
      let namesQueued = false;
      const placeNames = () => {
        if (!isOpen || namesQueued) return;
        namesQueued = true;
        requestAnimationFrame(() => {
          namesQueued = false;
          // Place by where the picture really is on screen, so a letterboxed or resizing stage cannot drift.
          const r = stage.getBoundingClientRect(), m = svg.getScreenCTM();
          if (!m) return;
          const s = m.a;
          const lit = picked ? [picked, ...near.map(([o]) => byId.get(o)).filter(Boolean)] : [];
          const order = picked ? lit : bySize;
          const cap = picked ? 24 : Math.round(8 * Math.min(4, base[2] / view[2]));
          const boxes = [], spans = [];
          for (const c of order) {
            if (spans.length >= cap) break;
            const p = new DOMPoint(X(c), Y(c)).matrixTransform(m);
            const sx = p.x - r.left, sy = p.y - r.top, rr = R(c) * s;
            if (sx < 0 || sx > r.width || sy < 0 || sy > r.height) continue;
            const name = c.dataset.name ?? '';
            const w = name.length * 6.4 + 6, h = 15, x = sx - w / 2, y = sy + rr + 3;
            if (x < 2 || x + w > r.width - 2 || y + h > r.height - 2) continue;
            if (boxes.some((b) => x < b[0] + b[2] && b[0] < x + w && y < b[1] + b[3] && b[1] < y + h)) continue;
            boxes.push([x, y, w, h]);
            const span = document.createElement('span');
            span.textContent = name;
            span.style.left = `${sx}px`;
            span.style.top = `${y}px`;
            if (c === picked) span.className = 'is-sel';
            spans.push(span);
          }
          names.replaceChildren(...spans);
        });
      };

      // When the stage changes shape (the sheet below grows as a person is picked, or the window turns),
      // fit the picture to it again around the same middle and zoom.
      const refit = () => {
        const cx = view[0] + view[2] / 2, cy = view[1] + view[3] / 2, k = view[2] / base[2];
        base = fit();
        const w = base[2] * k, h = base[3] * k;
        setView(clamp([cx - w / 2, cy - h / 2, w]));
      };
      const watch = new ResizeObserver(() => { if (isOpen) refit(); });

      // The dialog sits directly in <body>, so everything else can be made inert while it is open.
      document.body.append(full);
      let opener = null, stilled = [];
      const open = (dot) => {
        if (isOpen) return;
        isOpen = true;
        opener = document.activeElement instanceof HTMLElement && document.activeElement !== document.body ? document.activeElement : expand;
        full.hidden = false;
        document.documentElement.classList.add('nf-lock');
        stilled = [...document.body.children].filter((el) => el !== full && !el.inert);
        stilled.forEach((el) => { el.inert = true; });
        stage.prepend(svg);
        sheet.append(top, card);
        card.style.left = card.style.top = '';
        const r = stage.getBoundingClientRect();
        if (r.height > r.width && W > H) turn();
        base = fit();
        setView(base);
        show(dot ?? null);
        if (dot) focusOn(dot);
        watch.observe(stage);
        shut.focus();
        history.pushState({ netFull: true }, '');
      };
      const close = () => {
        if (!isOpen) return;
        isOpen = false;
        watch.disconnect();
        cancelAnimationFrame(anim);
        show(null);
        size(1);
        if (upright) turn();
        wrap.prepend(svg);
        svg.setAttribute('viewBox', `0 0 ${W0} ${H0}`);
        fig.after(top);
        wrap.append(card);
        names.replaceChildren();
        full.hidden = true;
        document.documentElement.classList.remove('nf-lock');
        stilled.forEach((el) => { el.inert = false; });
        stilled = [];
        // Back to where the reader was; the preview's expand button stands in for a tap on the picture.
        (opener?.isConnected && opener.offsetParent !== null ? opener : expand)?.focus({ preventScroll: true });
      };
      // Back closes the full-screen view, so the close button goes back too.
      shut.addEventListener('click', () => { if (history.state?.netFull) history.back(); else close(); });
      addEventListener('popstate', () => { if (isOpen) close(); });
      addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (isOpen) shut.click();
        else if (picked) show(null);
      });
      card.querySelector('.net-shut')?.addEventListener('click', () => show(null));
      // A click anywhere else on the page puts the card away. (A name in the card that was just replaced is no longer
      // in the page, so it counts as inside.)
      document.addEventListener('click', (e) => {
        if (isOpen || !picked || !e.target.isConnected || e.target.closest('.net-wrap, [data-pick]')) return;
        show(null);
      });
      out.addEventListener('click', () => glide(base));

      // Fingers on the full-screen stage: one drags, two pinch, a press that barely moves is a tap.
      const pts = new Map();
      let gest = null;
      const begin = (moved) => {
        const p = [...pts.values()];
        if (p.length === 1) gest = { v: view, a: p[0], moved };
        else if (p.length >= 2) gest = { v: view, d: Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y) || 1, m: { x: (p[0].x + p[1].x) / 2, y: (p[0].y + p[1].y) / 2 }, moved: true, pinch: true };
      };
      stage.addEventListener('pointerdown', (e) => {
        if (e.target.closest('button')) return;
        pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
        stage.setPointerCapture(e.pointerId);
        cancelAnimationFrame(anim);
        begin(pts.size > 1);
      });
      stage.addEventListener('pointermove', (e) => {
        if (!pts.has(e.pointerId) || !gest) return;
        pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
        const r = stage.getBoundingClientRect(), u = gest.v[2] / r.width, p = [...pts.values()];
        if (gest.pinch && p.length >= 2) {
          const d = Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y), m = { x: (p[0].x + p[1].x) / 2, y: (p[0].y + p[1].y) / 2 };
          // The point under the fingers stays under the fingers.
          const fx = gest.v[0] + (gest.m.x - r.left) * u, fy = gest.v[1] + (gest.m.y - r.top) * u;
          const w = Math.min(Math.max(gest.v[2] * (gest.d / d), base[2] / MAX), base[2]), u2 = w / r.width;
          setView(clamp([fx - (m.x - r.left) * u2, fy - (m.y - r.top) * u2, w]));
        } else if (!gest.pinch) {
          const dx = e.clientX - gest.a.x, dy = e.clientY - gest.a.y;
          if (!gest.moved && Math.hypot(dx, dy) > 8) gest.moved = true;
          if (gest.moved) setView(clamp([gest.v[0] - dx * u, gest.v[1] - dy * u, gest.v[2]]));
        }
      });
      const lift = (e) => {
        if (!pts.has(e.pointerId)) return;
        pts.delete(e.pointerId);
        const tap = gest && !gest.moved && e.type === 'pointerup';
        if (pts.size) { begin(true); return; }
        gest = null;
        if (tap) show(nearest(e, 24));
      };
      stage.addEventListener('pointerup', lift);
      stage.addEventListener('pointercancel', lift);
      // Wheel or trackpad zoom, for a narrow desktop window.
      stage.addEventListener('wheel', (e) => {
        e.preventDefault();
        const r = stage.getBoundingClientRect(), u = view[2] / r.width;
        const fx = view[0] + (e.clientX - r.left) * u, fy = view[1] + (e.clientY - r.top) * u;
        const w = Math.min(Math.max(view[2] * Math.exp(e.deltaY * .002), base[2] / MAX), base[2]), u2 = w / r.width;
        setView(clamp([fx - (e.clientX - r.left) * u2, fy - (e.clientY - r.top) * u2, w]));
      }, { passive: false });

      // In the page: on a phone any tap opens the full-screen view; with a mouse it picks a dot.
      svg.addEventListener('click', (e) => {
        if (isOpen) return;
        if (phone.matches) { open(null); return; }
        show(nearest(e, 12));
      });
      expand?.addEventListener('click', () => open(null));
      for (const b of document.querySelectorAll('[data-pick]')) {
        b.addEventListener('click', () => {
          const dot = byId.get(b.dataset.pick) ?? null;
          if (phone.matches && !isOpen) { open(dot); return; }
          show(dot);
          if (isOpen && dot) focusOn(dot);
          else reveal();
        });
      }
      if (matchMedia('(hover: hover)').matches) {
        svg.addEventListener('mousemove', (e) => { if (!isOpen && !phone.matches && !picked) show(nearest(e, 8), true); });
        svg.addEventListener('mouseleave', () => { if (!isOpen && !picked) show(null); });
      }
    })();
  </script>
  <script>
    // A bar shows its year and count on tap, click or keyboard focus; one at a time per chart.
    for (const chart of document.querySelectorAll<HTMLElement>('.cols')) {
      const bars = [...chart.querySelectorAll<HTMLElement>('.col[data-tip]')];
      const show = (bar: HTMLElement | null) => bars.forEach((b) => b.classList.toggle('is-on', b === bar));
      for (const bar of bars) {
        bar.addEventListener('click', () => show(bar.classList.contains('is-on') ? null : bar));
        // Only keyboard focus opens a bubble here; a mouse or tap press is handled by the click.
        bar.addEventListener('focus', () => { if (bar.matches(':focus-visible')) show(bar); });
        bar.addEventListener('keydown', (e) => {
          const i = bars.indexOf(bar);
          const next = e.key === 'ArrowRight' ? bars[i + 1] : e.key === 'ArrowLeft' ? bars[i - 1] : e.key === 'Escape' ? null : undefined;
          if (next === undefined) return;
          e.preventDefault();
          if (next) next.focus(); else { show(null); bar.blur(); }
        });
      }
    }
    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest?.('.col[data-tip]')) document.querySelectorAll('.col.is-on').forEach((b) => b.classList.remove('is-on'));
    });
  </script>
</Page>
