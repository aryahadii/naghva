{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item.schema.json",
  "title": "Published item",
  "description": "One file under data/published/items/<type>/<id>.yaml. Structure only; tools/validate.py checks the cross-file rules described in data/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type"],
  "properties": {
    "id": { "$ref": "#/$defs/item-id" },
    "type": { "$ref": "#/$defs/item-type" },
    "merged into": { "$ref": "#/$defs/item-id" },
    "statements": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/property-name" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/statement" }
      }
    }
  },
  "oneOf": [
    { "required": ["statements"], "not": { "required": ["merged into"] } },
    { "required": ["merged into"], "not": { "required": ["statements"] } }
  ],
  "$defs": {
    "item-id": {
      "description": "an item ID: Q and six characters from the ID alphabet",
      "type": "string",
      "pattern": "^Q[23456789abcdefghjkmnpqrstvwxyz]{6}$"
    },
    "source-name": {
      "description": "a capture file name without .md: lowercase letters, digits, '.', '_' and '-'",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "item-type": {
      "enum": ["person", "act", "release", "organization", "event", "place"]
    },
    "property-name": {
      "description": "a property name: lowercase words separated by single spaces",
      "type": "string",
      "pattern": "^[a-z]+( [a-z]+)*$"
    },
    "language": {
      "description": "a BCP 47 language tag such as fa, en or mul",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
    },
    "edtf": {
      "description": "a date in the supported EDTF subset: 2004, 2004-11, 2004-11-17, 2004~, 2004?, 200X or an interval a/b (see data/README.md, Dates)",
      "type": "string",
      "pattern": "^(?:[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?[~?%]?|[0-9]{3}X)(?:/(?:[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?[~?%]?|[0-9]{3}X))?$"
    },
    "url": {
      "description": "an http(s) URL",
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "term": {
      "description": "a term: lowercase words separated by single spaces",
      "type": "string",
      "pattern": "^[a-z]+( [a-z]+)*$"
    },
    "special": {
      "enum": ["unknown value", "no value"]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "language"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "language": { "$ref": "#/$defs/language" }
      }
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date"],
      "properties": {
        "date": { "$ref": "#/$defs/edtf" },
        "calendar": { "enum": ["gregorian", "jalali"] }
      }
    },
    "value": {
      "anyOf": [
        { "$ref": "#/$defs/item-id" },
        { "$ref": "#/$defs/url" },
        { "$ref": "#/$defs/term" },
        { "$ref": "#/$defs/special" },
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/date" }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "quote", "accessed"],
      "properties": {
        "source": { "$ref": "#/$defs/source-name" },
        "quote": {
          "description": "a quote with at least one visible character",
          "type": "string",
          "pattern": "\\S"
        },
        "accessed": {
          "description": "a full date, YYYY-MM-DD",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "references"],
      "properties": {
        "value": { "$ref": "#/$defs/value" },
        "qualifiers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/property-name" },
          "additionalProperties": {
            "anyOf": [
              { "$ref": "#/$defs/value" },
              { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/value" } }
            ]
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reference" }
        },
        "rank": { "enum": ["preferred", "normal", "deprecated"] },
        "editorial": {
          "description": "a Persian display spelling with no attested Persian form; its references support the original name (names only)",
          "const": true
        }
      }
    }
  }
}
